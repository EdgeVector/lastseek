{
  "app_id": "lastseek",
  "version": "0.2.0",
  "source": "https://github.com/EdgeVector/lastseek.git",
  "metadata": {
    "display_name": "lastseek",
    "description": "LastDB semantic search",
    "homepage_url": "https://github.com/EdgeVector/lastseek"
  },
  "run": {
    "runtime": "command",
    "entrypoint": "dist/lastseek"
  },
  "schemas": [],
  "access": {
    "read": [
      "brain/Design",
      "brain/Task",
      "brain/Concept",
      "brain/Preference",
      "brain/Reference",
      "brain/Agent",
      "brain/Project",
      "brain/Spike",
      "brain/Sop",
      "brain/Decision",
      "brain/BrainAttachmentIndex"
    ],
    "write": [],
    "extensions": ["changes"]
  },
  "outbox_format_version": 1,
  "install": {
    "prepare": [
      {
        "argv": [
          "python3",
          "scripts/registry-prepare.py"
        ],
        "timeout_s": 600
      }
    ],
    "probe": [
      {
        "argv": [
          "./dist/lastseek",
          "--help"
        ],
        "timeout_s": 30
      },
      {
        "argv": [
          "bash",
          "scripts/registry-models.sh"
        ],
        "timeout_s": 30
      }
    ],
    "links": [
      {
        "source": "dist/lastseek",
        "command": "lastseek"
      }
    ],
    "post_install": [],
    "requires": []
  },
  "audience": "public"
}
